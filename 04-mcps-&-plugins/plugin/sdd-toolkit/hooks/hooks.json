{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/spec-vc-gate.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_sdd-toolkit_gcs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gcs-allowlist.sh\""
          }
        ]
      }
    ]
  }
}
